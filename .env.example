# Copy to .env and fill in — or just run `pnpm setup`, which generates this file
# with fresh secrets and sensible local defaults.

# --- identity --- what this blog calls itself; read at runtime, no rebuild needed
SITE_NAME=My Blog             # titles, OG siteName, feeds, PWA, authenticator entry
SITE_SHORT_NAME=              # PWA short name; empty = SITE_NAME
SITE_AUTHOR=                  # bylines, JSON-LD author, footer; empty = SITE_NAME
SITE_WORDMARK=                # header/admin wordmark; a dot is accented, as in "my.blog"
SITE_CONTACT_EMAIL=           # shown on the seeded contact page
SITE_TAGLINE_TR=              # home page heading; empty = SITE_NAME
SITE_TAGLINE_EN=
SITE_DESCRIPTION_TR=          # home lede, feed description, llms.txt header
SITE_DESCRIPTION_EN=

# --- core ---
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
POSTGRES_DB=blog              # database name; compose creates it on first run
IMAGE_NAME=blog               # built image name (production compose only)
DATABASE_URL=postgres://kb:kb@localhost:5432/blog
TZ=Europe/Istanbul
ROLE=app                      # app | worker
INTERNAL_SECRET=change-me     # worker -> app loopback (revalidate); openssl rand -hex 32
UPLOADS_DIR=./data/uploads

# --- auth (Better Auth) ---
BETTER_AUTH_SECRET=change-me  # openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me   # the admin is created on first boot

# --- SEO / indexing ---
INDEXNOW_KEY=                  # 32 chars [a-zA-Z0-9-], served at /<key>.txt
GSC_SITE_URL=                  # e.g. sc-domain:example.com
GOOGLE_APPLICATION_CREDENTIALS=

# --- ads / consent ---
NEXT_PUBLIC_ADSENSE_CLIENT=    # ca-pub-XXXXXXXXXXXXXXXX; empty = no ads
ADSENSE_SLOT_IN1=
ADSENSE_SLOT_IN2=
ADSENSE_SLOT_END=
ADSENSE_SLOT_LIST=
GEO_OVERRIDE_ENABLED=0         # 1 only in dev/e2e: ?geo=TR
CONSENT_TTL_DAYS=180
CONSENT_POLICY_VERSION=1
CF_WEB_ANALYTICS_TOKEN=

# --- AI (OpenAI) --- empty OPENAI_API_KEY = every AI feature stays off
OPENAI_API_KEY=
AI_MODEL_DEFAULT=gpt-5.6-terra
AI_MODEL_LINKER=gpt-5.6-luna
AI_MODEL_REVIEW=gpt-5.6-terra
AI_MODEL_TRANSLATE=gpt-5.6-terra
AI_DAILY_MAX_CALLS=80
AI_DAILY_MAX_USD=3
AI_KILL_SWITCH=0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1024

# --- ops ---
ALERT_WEBHOOK_URL=
LOG_LEVEL=info

# --- media/CDN ---
NEXT_PUBLIC_MEDIA_BASE=        # empty = same-origin /uploads
