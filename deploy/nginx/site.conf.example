# Template — replace example.com throughout, drop the .example suffix, and symlink into
# sites-enabled, then: certbot --nginx -d example.com -d www.example.com
# If you front this with Cloudflare, configure real client IPs globally in
# /etc/nginx/conf.d/cloudflare-real-ip.conf.

limit_req_zone $binary_remote_addr zone=kb_auth:10m rate=10r/m;

server {
    server_name example.com www.example.com;

    # canonical host
    if ($host = www.example.com) { return 301 https://example.com$request_uri; }

    client_max_body_size 16m;

    # never reachable from outside
    location ^~ /api/internal/ { return 404; }
    location ^~ /_next/image   { return 404; }

    location ^~ /_next/static/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /api/auth/ {
        limit_req zone=kb_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header CF-IPCountry $http_cf_ipcountry;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header CF-IPCountry $http_cf_ipcountry;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_buffering off;          # RSC streaming
        proxy_read_timeout 120s;
    }

    listen 80;
    listen [::]:80;
}
